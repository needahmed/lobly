{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@lobly/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@lobly/client-core": ["../../packages/client-core/src/index.ts"],
      "@lobly/lcu-endpoints": ["../../packages/lcu-endpoints/endpoints.json"]
    }
  },
  "include": ["electron", "renderer", "vite.config.ts", "esbuild.mjs"]
}
